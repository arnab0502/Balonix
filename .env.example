# ---------------------------------------------------------------------------
# TotalFootball configuration
# Copy to `.env` and fill in. The app runs fine with NO .env at all (mock mode).
# ---------------------------------------------------------------------------

# Data provider: "mock" (no key, seeded realistic data) or "apifootball" (live)
TF_PROVIDER=mock

# API-Football key. Get one at https://www.api-football.com/
# Free tier = 100 req/day (demo only). Pro = $19/mo, 7500 req/day (recommended).
TF_API_FOOTBALL_KEY=

# Use "api-football-v1.p.rapidapi.com" if your key came from RapidAPI instead.
TF_API_FOOTBALL_HOST=v3.football.api-sports.io

# --- Request budget knobs -------------------------------------------------
# How often the browser asks the server for live score updates (seconds).
# 60 is comfortable on Pro. Raise to 300 if you are stuck on the free tier.
TF_LIVE_POLL_SECONDS=60

# How many clubs the daily transfer sweep covers per run.
# 98 = every big-5 club every day (needs Pro). 20 = free-tier friendly but
# a full sweep then takes ~5 days, so you WILL lag on some transfers.
TF_TRANSFER_SWEEP_SIZE=98

# Cache TTLs in seconds
TF_TTL_LIVE=45
TF_TTL_FIXTURES=900
TF_TTL_STANDINGS=21600
TF_TTL_TRANSFERS=43200

# Server
TF_HOST=127.0.0.1
TF_PORT=8000

# --- Podcast tab ----------------------------------------------------------
TF_YOUTUBE_CHANNEL=
TF_YOUTUBE_API_KEY=
TF_YOUTUBE_TITLE=
TF_TTL_VIDEOS=1800

# --- Hosting --------------------------------------------------------------
TF_TRANSFER_RETENTION_DAYS=1095
TF_AUTH_USER=
TF_AUTH_PASS=
